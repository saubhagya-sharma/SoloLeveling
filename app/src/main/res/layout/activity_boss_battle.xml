<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BOSS BATTLE"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_boss_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Iron Sentinel"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_boss_requirement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Bench Press\n16kg x 12 reps\n3 sets"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/text_attempts_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Attempts Left: ❤️❤️❤️"
        android:textSize="18sp" />

    <Button
        android:id="@+id/button_start_logging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Start Logging" />

</LinearLayout>
